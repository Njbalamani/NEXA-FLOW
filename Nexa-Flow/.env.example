DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL example:
# DATABASE_URL=postgresql://nexaflow:nexaflow@localhost:5432/nexaflow

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
# Set to Redis in multi-worker deployments so webhook replay protection is shared.
CACHE_URL=

NEXAFLOW_ENCRYPTION_KEY=
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=12

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_FROM=no-reply@nexaflow.local
FRONTEND_URL=http://localhost:8000

MAX_NODES_PER_WORKFLOW=50
MAX_EXECUTION_SECONDS=60
WEBHOOK_MAX_BODY_BYTES=262144
WEBHOOK_REPLAY_TTL_SECONDS=300
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_RATE_LIMIT_PER_MINUTE=300
TRUST_X_FORWARDED_FOR=false
# Comma-separated allowlist of environment variables workflows may read as headers.
ALLOWED_ENV_HEADERS=
RATE_LIMIT_AUTH=10/min
RATE_LIMIT_API=120/min
RATE_LIMIT_WEBHOOK=300/min
RATE_LIMIT_AI=20/min
RATE_LIMIT_BILLING=20/min

TIME_ZONE=UTC
LOG_LEVEL=INFO
